<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="google-site-verification" content="google9a428d7d0a30a656" />
<title>Login - AcademiaPro</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="/styles.css" rel="stylesheet">
<style>
  body {
    background:
      linear-gradient(135deg, rgba(7, 18, 28, 0.48), rgba(8, 18, 22, 0.42)),
      url('/login-bg.svg') center/cover no-repeat fixed;
    color: #1f2937;
    font-family: 'DM Sans', 'Segoe UI', sans-serif;
  }

  .login-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(120deg, rgba(5, 15, 20, 0.42), rgba(15, 27, 31, 0.28)),
      url('/login-bg.svg') center/cover no-repeat fixed;
  }

  .login-hero::before,
  .login-hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(8px);
    pointer-events: none;
  }

  .login-hero::before {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(14, 165, 133, 0.14), rgba(14, 165, 133, 0.02) 55%, transparent 72%);
    top: -180px;
    left: -120px;
  }

  .login-hero::after {
    width: 660px;
    height: 660px;
    background: radial-gradient(circle, rgba(45, 82, 98, 0.1), rgba(45, 82, 98, 0.02) 52%, transparent 72%);
    bottom: -260px;
    right: -140px;
  }

  .login-content {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
    max-width: 1180px;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .login-info {
    color: #ffffff;
    padding-left: 1rem;
  }

  .login-info h1 {
    font-size: clamp(3rem, 5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
    margin-bottom: 1.5rem;
    color: #ffffff;
    text-shadow: 0 6px 30px rgba(0, 0, 0, 0.45);
    font-weight: 600;
  }

  .login-info p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.2rem;
    margin-bottom: 2.1rem;
    line-height: 1.7;
    max-width: 580px;
  }

  .features {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .features li {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.15rem;
    font-size: 1.14rem;
    color: rgba(255, 255, 255, 0.92);
    font-weight: 500;
  }

  .features i {
    color: #4ade80;
    font-size: 1.2rem;
    min-width: 22px;
  }

  .form {
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.2);
    padding: 2.4rem 2rem;
    border-radius: 26px;
    box-shadow: 0 28px 70px rgba(15, 23, 42, 0.08);
    width: min(100%, 470px);
    justify-self: center;
  }

  .form h2 {
    text-align: center;
    margin-bottom: 1.6rem;
    color: #1f2d2a;
    font-size: 2.8rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .form-group {
    margin-bottom: 1.3rem;
  }

  .form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.55rem;
    color: #24313c;
    font-size: 1rem;
  }

  .form-group input {
    width: 100%;
    height: 52px;
    padding: 0.8rem 1rem;
    border: 1px solid #dfe5e3;
    border-radius: 12px;
    background: #f7f8f7;
    font-family: inherit;
    font-size: 1rem;
    color: #1f2937;
    transition: all 0.2s ease;
  }

  .form-group input:focus {
    outline: none;
    border-color: #36b58f;
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(54, 181, 143, 0.12);
  }

  .form-group button,
  .btn-google,
  .btn-secondary {
    width: 100%;
    min-height: 50px;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1.05rem;
    font-family: inherit;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
  }

  .form-group button:hover,
  .btn-google:hover,
  .btn-secondary:hover {
    transform: translateY(-1px);
    filter: brightness(0.98);
  }

  .form-group button {
    background: linear-gradient(135deg, #1fb786 0%, #1aa77b 100%);
    color: #ffffff;
    box-shadow: 0 14px 24px rgba(27, 171, 120, 0.2);
  }

  .btn-google {
    background: linear-gradient(135deg, #1aa77b 0%, #129e73 100%);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    box-shadow: 0 12px 22px rgba(18, 158, 115, 0.18);
  }

  .btn-secondary {
    background: linear-gradient(135deg, #f4faf7 0%, #edf5f2 100%);
    color: #1f2d2a;
    border: 1px solid rgba(28, 123, 90, 0.12);
    box-shadow: 0 8px 18px rgba(12, 36, 31, 0.04);
  }

  .btn-google i,
  .btn-secondary i,
  .form-group button i {
    font-size: 1.05rem;
  }

  .alert {
    border-radius: 12px;
    padding: 0.9rem 1rem;
    margin-bottom: 1.1rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .alert-error {
    background: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
  }

  .alert-info {
    background: #ecfeff;
    color: #0f766e;
    border: 1px solid #a5f3fc;
  }

  .remember-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: #40515d;
    margin-bottom: 1.2rem;
  }

  .remember-row label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.95rem;
    color: #475569;
    cursor: pointer;
  }

  .remember-row input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: #1ca779;
  }

  .form p {
    text-align: center;
    margin-top: 1.25rem;
    color: #4b5563;
    font-size: 1rem;
  }

  .form a {
    color: #1d5d52;
    font-weight: 600;
  }

  .auth-link-status {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    color: #0f766e;
  }

  @media (max-width: 900px) {
    .login-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      max-width: 580px;
    }

    .login-info {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .login-hero {
      padding: 1.2rem;
    }

    .form {
      padding: 1.5rem 1.1rem;
      border-radius: 22px;
    }

    .form h2 {
      font-size: 2.2rem;
    }

    .remember-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
</head>
<body>
<div class="login-hero">
  <div class="login-content">
    <div class="login-info">
      <h1>Welcome to AcademiaPro</h1>
      <p>Find your perfect faculty or professor position with our advanced job portal.</p>
      <ul class="features">
        <li><i class="fas fa-check-circle"></i> Browse top university positions</li>
        <li><i class="fas fa-check-circle"></i> AI-powered interviews</li>
        <li><i class="fas fa-check-circle"></i> Compare job offers</li>
        <li><i class="fas fa-check-circle"></i> Expert matching algorithm</li>
      </ul>
    </div>
    
    <div class="form">
      <h2><i class="fas fa-sign-in-alt"></i> Login</h2>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (info) { %>
        <div class="alert alert-info"><%= info %></div>
      <% } %>
      <form action="/login" method="POST" id="loginForm">
        <div class="form-group">
          <label for="email"><i class="fas fa-envelope"></i> Email</label>
          <input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email" autofocus>
        </div>
        <div class="form-group">
          <label for="password"><i class="fas fa-lock"></i> Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
        </div>
        <div class="form-group remember-row" style="margin-bottom: 0;">
          <label><input type="checkbox" name="remember" id="rememberMe"> Remember me</label>
          <label><input type="checkbox" id="showPassword"> Show password</label>
        </div>
        <div class="form-group">
          <button type="submit"><i class="fas fa-sign-in-alt"></i> Login</button>
        </div>
      </form>
      <div class="form-group">
        <button id="firebaseGoogleBtn" type="button" class="btn btn-google"><i class="fab fa-google"></i> Sign in with Google</button>
      </div>
      <div class="form-group">
        <button id="emailLinkBtn" type="button" class="btn btn-secondary"><i class="fas fa-envelope"></i> Email me a sign-in link</button>
        <div id="emailLinkStatus" class="auth-link-status" role="status" aria-live="polite"></div>
      </div>
      <p>Don't have an account? <a href="/register"><i class="fas fa-arrow-right"></i> Register now</a></p>
      <p>Forgot your password? <a href="/reset"><i class="fas fa-key"></i> Reset it here</a></p>
      <p>HR user? <a href="/hr-login"><i class="fas fa-arrow-right"></i> Login here</a></p>
    </div>
  </div>
</div>
</body>
<script type="module">
  import { describeFirebaseAuthError, initFirebaseAuth, signInWithPopup } from '/firebase-config.js';
  import { setupEmailLinkAuth } from '/email-link-auth.js';

  setupEmailLinkAuth({ emailId: 'email', buttonId: 'emailLinkBtn', statusId: 'emailLinkStatus', redirectFallback: '/dashboard' });

  const completeGoogleSignIn = async (result, redirectFallback) => {
    const idToken = await result.user.getIdToken();
    const response = await fetch('/auth/google-firebase', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken })
    });
    if (!response.ok) {
      throw new Error(await response.text());
    }
    const data = await response.json();
    window.location.href = data.redirect || redirectFallback;
  };

  const firebaseAuth = await initFirebaseAuth();
  try {
    const redirectResult = await firebaseAuth.getRedirectResult(firebaseAuth.auth);
    if (redirectResult?.user) {
      await completeGoogleSignIn(redirectResult, '/dashboard');
    }
  } catch (error) {
    console.error('Firebase Google redirect sign-in error:', error);
    alert(describeFirebaseAuthError(error));
  }

  document.getElementById('firebaseGoogleBtn').addEventListener('click', async () => {
    try {
      try {
        await completeGoogleSignIn(await signInWithPopup(firebaseAuth.auth, firebaseAuth.googleProvider), '/dashboard');
      } catch (error) {
        if (error?.code === 'auth/popup-closed-by-user' || error?.code === 'auth/cancelled-popup-request') {
          throw error;
        }
        window.location.assign('/auth/google');
      }
    } catch (error) {
      console.error('Firebase Google sign-in error:', error);
      alert(describeFirebaseAuthError(error));
    }
  });

  const emailInput = document.getElementById('email');
  const rememberCheckbox = document.getElementById('rememberMe');
  const loginForm = document.getElementById('loginForm');

  const savedEmail = localStorage.getItem('academiaProLastEmail');
  if (savedEmail && emailInput) {
    emailInput.value = savedEmail;
  }

  loginForm?.addEventListener('submit', () => {
    if (emailInput && rememberCheckbox && rememberCheckbox.checked) {
      localStorage.setItem('academiaProLastEmail', emailInput.value.trim());
    } else if (emailInput) {
      localStorage.removeItem('academiaProLastEmail');
    }
  });

  document.getElementById('showPassword')?.addEventListener('change', (event) => {
    const passwordField = document.getElementById('password');
    if (passwordField) {
      passwordField.type = event.target.checked ? 'text' : 'password';
    }
  });
</script>
</html>