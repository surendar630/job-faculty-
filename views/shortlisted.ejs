<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shortlisted Resumes - AcademiaPro</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="/styles.css" rel="stylesheet">
<style>
.shortlisted-header {
  background: linear-gradient(135deg, #04AA6D 0%, #059669 100%);
  color: white;
  padding: 3rem 2rem;
  border-radius: 12px;
  margin-bottom: 3rem;
  box-shadow: var(--shadow-lg);
}

.shortlisted-header h1 {
  color: white;
  font-size: 2.2rem;
  margin-bottom: 0.5rem;
}

.shortlisted-header p {
  color: rgba(255,255,255,0.9);
  font-size: 1.1rem;
  margin: 0;
}

.training-hero {
  display: grid;
  grid-template-columns: 1.3fr 0.9fr;
  gap: 1rem;
  background: linear-gradient(135deg, #ffffff 0%, #f4fff8 100%);
  border: 1px solid #dff6e8;
  border-radius: 18px;
  padding: 1.4rem;
  box-shadow: var(--shadow-md);
  margin-bottom: 1.6rem;
}

.training-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  background: #e9fdf2;
  color: #0f7d4d;
  padding: 0.45rem 0.8rem;
  border-radius: 999px;
  font-weight: 700;
  font-size: 0.9rem;
  margin-bottom: 0.8rem;
}

.training-hero h2 {
  margin: 0 0 0.6rem;
  font-size: 1.35rem;
  color: #282A35;
}

.training-hero p {
  margin: 0;
  color: #4b5563;
  line-height: 1.6;
}

.training-highlight {
  display: grid;
  gap: 0.7rem;
}

.training-highlight-item {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  padding: 0.85rem 0.95rem;
  border-radius: 12px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  color: #334155;
  font-weight: 600;
}

.training-highlight-item i {
  color: #04AA6D;
}

.training-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
  margin-bottom: 1.6rem;
}

.training-card {
  background: white;
  border-radius: 14px;
  border: 1px solid #e5f7ed;
  box-shadow: var(--shadow-sm);
  padding: 1rem;
}

.training-card-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #04AA6D, #059862);
  color: white;
  margin-bottom: 0.8rem;
}

.training-card h3 {
  margin: 0 0 0.45rem;
  font-size: 1rem;
  color: #282A35;
}

.training-card p {
  margin: 0;
  color: #64748b;
  font-size: 0.95rem;
  line-height: 1.5;
}

.resume-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2rem;
}

.resume-card {
  background: white;
  border-radius: 12px;
  box-shadow: var(--shadow-md);
  overflow: hidden;
  transition: var(--transition);
  border: 1px solid #ddd;
}

.resume-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-xl);
}

.resume-header {
  background: linear-gradient(135deg, #f1f1f1, #f5f3ff);
  padding: 1.5rem;
  border-bottom: 1px solid #ddd;
}

.resume-title {
  font-size: 1.2rem;
  font-weight: 600;
  color: #282A35;
  margin-bottom: 0.5rem;
}

.resume-meta {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  color: #666;
  font-size: 0.9rem;
}

.resume-meta span {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.resume-content {
  padding: 1.5rem;
}

.resume-actions {
  padding: 1rem 1.5rem 1.5rem;
  border-top: 1px solid #f1f1f1;
  display: flex;
  gap: 0.75rem;
}

.resume-actions .btn {
  flex: 1;
  padding: 0.75rem;
  font-size: 0.9rem;
}

.empty-state {
  text-align: center;
  padding: 3rem;
  color: #666;
  background: white;
  border-radius: 12px;
  box-shadow: var(--shadow-md);
}

.empty-state i {
  font-size: 3rem;
  color: #ddd;
  margin-bottom: 1rem;
}

@media (max-width: 768px) {
  .resume-grid {
    grid-template-columns: 1fr;
  }

  .resume-meta {
    flex-direction: column;
    gap: 0.5rem;
  }
}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="logo"><i class="fas fa-graduation-cap"></i> AcademiaPro</div>
  <div class="nav-links">
    <span onclick="window.location.href='/dashboard'"><i class="fas fa-home"></i> Dashboard</span>
    <span onclick="window.location.href='/jobs'"><i class="fas fa-briefcase"></i> Jobs</span>
    <span onclick="window.location.href='/profile'"><i class="fas fa-user"></i> Profile</span>
    <% if (user.role === 'hr') { %><span onclick="window.location.href='/office'"><i class="fas fa-building"></i> Office</span><% } %>
    <% if (user.role === 'admin') { %><span onclick="window.location.href='/admin'"><i class="fas fa-cog"></i> Admin</span><% } %>
    <form action="/logout" method="POST" style="display:inline;">
      <button type="submit" style="background:none;border:none;color:#ddd;cursor:pointer;font-weight:500;transition:var(--transition);" onmouseover="this.style.color='#04AA6D'" onmouseout="this.style.color='#ddd'"><i class="fas fa-sign-out-alt"></i> Logout</button>
    </form>
  </div>
</nav>

<div class="container">
  <!-- HEADER -->
  <div class="shortlisted-header">
    <h1><i class="fas fa-check-circle"></i> Shortlisted Candidates</h1>
    <p>Review resumes of shortlisted applicants for faculty positions with professional screening and AICTE-focused training support.</p>
  </div>

  <div class="training-hero">
    <div>
      <div class="training-pill"><i class="fas fa-graduation-cap"></i> Professional Shortlisting Training</div>
      <h2>Strengthen your screening workflow with structured professional review and interview readiness.</h2>
      <p>Use this module to evaluate resumes more professionally, align with AICTE-style standards, and prepare for the next stage of faculty recruitment.</p>
    </div>
    <div class="training-highlight">
      <div class="training-highlight-item"><i class="fas fa-book-open"></i><span>Resume review and professional training support</span></div>
      <div class="training-highlight-item"><i class="fas fa-balance-scale"></i><span>AICTE-informed shortlist evaluation</span></div>
      <div class="training-highlight-item"><i class="fas fa-video"></i><span>Live interview and video-calling readiness</span></div>
    </div>
  </div>

  <div class="training-grid">
    <% const trainingCards = (resumeTraining && resumeTraining.length) ? resumeTraining : [
      { title: 'Professional Resume Review', description: 'Review shortlisted candidates with a structured, quality-based approach that supports better hiring decisions.' },
      { title: 'AICTE-Oriented Screening', description: 'Follow a more standardized and professional selection mindset aligned to academic recruitment norms.' },
      { title: 'Interview Preparation', description: 'Move candidates forward into live practice and interview settings with confidence and clarity.' }
    ]; %>
    <% trainingCards.forEach((training) => { %>
      <div class="training-card">
        <div class="training-card-icon"><i class="fas fa-wand-magic-sparkles"></i></div>
        <h3><%= training.title %></h3>
        <p><%= training.description %></p>
      </div>
    <% }); %>
  </div>

  <!-- RESUMES GRID -->
  <% if (applications.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-inbox"></i>
      <h3>No Shortlisted Resumes Yet</h3>
      <p>Candidates will appear here once they are shortlisted by administrators.</p>
    </div>
  <% } else { %>
    <div class="resume-grid">
      <% applications.forEach(app => { %>
        <div class="resume-card">
          <div class="resume-header">
            <div class="resume-title"><i class="fas fa-file-alt"></i> <%= app.job_title %></div>
            <div class="resume-meta">
              <span><i class="fas fa-user"></i> <%= app.candidate_name || 'Candidate' %></span>
              <span><i class="fas fa-envelope"></i> <%= app.candidate_email || 'N/A' %></span>
              <span><i class="fas fa-school"></i> <%= app.university %></span>
              <span><i class="fas fa-map-marker-alt"></i> <%= app.location %></span>
            </div>
          </div>

          <div class="resume-content">
            <% const universityForwardLink = 'https://www.google.com/search?q=' + encodeURIComponent((app.job_title || 'Faculty') + ' ' + (app.university || 'University') + ' careers apply'); %>
            <p style="color: #666; margin: 0;">
              <strong>Status:</strong> 
              <span style="background: #e8f5e9; color: #059862; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.85rem; font-weight: 600;">
                <i class="fas fa-check"></i> Shortlisted
              </span>
            </p>
            <% if (typeof app.resume_scan_score !== 'undefined' || app.resume_scan_report) { %>
              <div style="margin-top:0.85rem; padding:0.9rem; background:#f1f1f1; border-radius:10px; color:#334155;">
                <strong>AICTE scan:</strong> <%= app.resume_scan_score || 'N/A' %>% | <%= app.resume_aicte_status || 'pending' %>
                <% if (app.resume_scan_report) { %>
                  <div style="margin-top:0.65rem; white-space:pre-wrap; font-size:0.92rem; line-height:1.5;"><%= app.resume_scan_report %></div>
                <% } %>
              </div>
            <% } %>
            <% if (app.shortlisted_field) { %>
              <div style="margin-top:0.75rem; padding:0.75rem 0.9rem; border-radius:8px; background:#ecfdf5; color:#065f46; font-weight:600;">
                <i class="fas fa-check-circle"></i> Shortlisted for: <%= app.shortlisted_field %>
              </div>
            <% } %>

            <form action="/shortlisted/<%= app.id %>/forward" method="POST" style="margin-top:1rem; display:grid; gap:0.7rem; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:0.9rem;">
              <label style="font-weight:600; color:#334155;">Forward candidate to university / college</label>
              <input type="text" name="university" placeholder="e.g. IISc Bangalore or Christ University" style="padding:0.7rem 0.8rem; border-radius:8px; border:1px solid #dbe3ef;" required>
              <textarea name="notes" rows="2" placeholder="Add a quick forwarding note for the hiring team..." style="padding:0.7rem 0.8rem; border-radius:8px; border:1px solid #dbe3ef; resize:vertical;"></textarea>
              <div style="display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
                <button type="submit" class="btn btn-primary" style="flex:1; min-width: 170px;"><i class="fas fa-paper-plane"></i> Forward Resume</button>
                <a href="<%= universityForwardLink %>" target="_blank" rel="noopener" class="btn btn-secondary" style="text-decoration:none; white-space:nowrap;">
                  <i class="fas fa-external-link-alt"></i> Open university careers
                </a>
              </div>
            </form>
          </div>

          <div class="resume-actions">
            <% if (app.resume_path) { %>
              <a href="/<%= app.resume_path %>" target="_blank" class="btn btn-primary">
                <i class="fas fa-download"></i> View Resume
              </a>
              <a href="/interview/<%= app.id %>" class="btn btn-secondary">
                <i class="fas fa-microphone"></i> Start Interview
              </a>
              <a href="/interview/<%= app.id %>?mode=coding" class="btn btn-secondary">
                <i class="fas fa-code"></i> Start Coding Round
              </a>
            <% } else { %>
              <span class="btn btn-secondary" style="background: #f3f4f6; color: #9ca3af; cursor: not-allowed;">
                <i class="fas fa-file"></i> No Resume
              </span>
            <% } %>
            <% if (user.role === 'hr') { %>
              <form action="/hr/application/<%= app.id %>/unshortlist" method="POST" style="display:inline; margin-left: 0.5rem;">
                <button type="submit" class="btn btn-secondary" style="background:#fef3c7; color:#92400e;">
                  <i class="fas fa-arrow-left"></i> Remove
                </button>
              </form>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

</body>
<script>
// If redirected with ?open=/path, open the resume in a new tab (admins/HR)
;(function() {
  try {
    const params = new URLSearchParams(window.location.search);
    const openUrl = params.get('open');
    if (openUrl && (openUrl.startsWith('/') || openUrl.startsWith(window.location.origin))) {
      window.open(openUrl, '_blank');
      history.replaceState(null, '', window.location.pathname);
    }
  } catch (e) {
    console.error('Auto-open resume failed:', e);
  }
})();
</script>
</html>